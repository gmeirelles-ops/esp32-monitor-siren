rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isManager() {
      return isAuthenticated() && request.auth.token.manager == true;
    }

    function hasStationId() {
      return request.resource.data.keys().hasAll(['station_id'])
        && request.resource.data.station_id is string
        && request.resource.data.station_id.size() > 0;
    }

    function stationMatchesDoc(stationId) {
      return request.resource.data.station_id == stationId;
    }

    match /stations/{stationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && hasStationId()
        && stationMatchesDoc(stationId);
      allow delete: if false;
    }

    match /devices/{deviceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && hasStationId();
      allow delete: if false;
    }

    match /test_results/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && hasStationId();
      allow delete: if false;

      match /seriais/{serial} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && hasStationId();
        allow delete: if false;
      }

      match /reprovadas/{sequencial} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && hasStationId();
        allow update: if false;
        allow delete: if false;
      }
    }

    match /batches/{batchId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManager();
    }

    match /operators/{codigo} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManager();
    }

    match /{path=**}/seriais/{serial} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasStationId();
      allow update: if isAuthenticated() && hasStationId();
      allow delete: if false;
    }

    match /{path=**}/reprovadas/{sequencial} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasStationId();
      allow update: if false;
      allow delete: if false;
    }
  }
}
