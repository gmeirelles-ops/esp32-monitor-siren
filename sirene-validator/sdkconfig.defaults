CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_IPV4=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_SPIFFS_MAX_PARTITIONS=1
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# OTA pela LAN (HTTP) — documentado em GUIA_COMPLETO §11
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
# Portal Wi-Fi: browsers Windows enviam headers > 512 bytes
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
# Produção: preserva NVS/lote/fila após OTA (reprovisionamento: sdkconfig.defaults.provisioning)
# CONFIG_OTA_ERASE_NVS_ON_BOOT is not set
# TLS: verificação CA ativa (crt bundle para mqtt.diponto.com).
# Brokers LAN autoassinados: CONFIG_SIRENE_MQTT_LAN_INSECURE_TLS em board_config.
# CONFIG_ESP_TLS_INSECURE is not set
# CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY is not set
CONFIG_SIRENE_MQTT_LAN_INSECURE_TLS=y
CONFIG_SIRENE_OTA_REQUIRE_HTTPS=y
CONFIG_SIRENE_OLED_ENABLE=y
CONFIG_SIRENE_WIFI_AP_PASSWORD="diponto2026"
CONFIG_SIRENE_MQTT_DEFAULT_USER="devices"
CONFIG_SIRENE_MQTT_DEFAULT_PASSWORD="w1FefRLm+q1_O8H"
